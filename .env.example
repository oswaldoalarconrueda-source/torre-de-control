# Torre de Control Effi — variables de entorno
# Copia este archivo a .env y llena los valores. El .env NUNCA se sube a git (está en .gitignore).
#
# API key de Effi: en cada empresa, Administración → Usuarios → Ver más detalles → API key.
# Recomendado: crear un usuario "API Torre de Control" con perfil de SOLO CONSULTA y usar su key.
# Cada key vence a los 360 días (botón "Renovar API Key"); al renovarla hay que actualizarla aquí.

EFFI_API_BASE=https://effi.com.co/api

# Lista de cuentas a conectar (slugs separados por coma). Cada slug usa las variables EFFI_<SLUG>_*.
EFFI_ACCOUNTS=TIENDA_CO,TIENDA_EC,TIENDA_GT,TIENDA_CR,PROV_GT1,PROV_GT2,PROV_HN,PROV_CR

# ── Tiendas ────────────────────────────────────────────────
EFFI_TIENDA_CO_NOMBRE=NATURALFITT CO
EFFI_TIENDA_CO_TIPO=tienda
EFFI_TIENDA_CO_PAIS=CO
EFFI_TIENDA_CO_API_KEY=

EFFI_TIENDA_EC_NOMBRE=
EFFI_TIENDA_EC_TIPO=tienda
EFFI_TIENDA_EC_PAIS=EC
EFFI_TIENDA_EC_API_KEY=

EFFI_TIENDA_GT_NOMBRE=
EFFI_TIENDA_GT_TIPO=tienda
EFFI_TIENDA_GT_PAIS=GT
EFFI_TIENDA_GT_API_KEY=

EFFI_TIENDA_CR_NOMBRE=
EFFI_TIENDA_CR_TIPO=tienda
EFFI_TIENDA_CR_PAIS=CR
EFFI_TIENDA_CR_API_KEY=

# ── Proveedurías ───────────────────────────────────────────
EFFI_PROV_GT1_NOMBRE=
EFFI_PROV_GT1_TIPO=proveeduria
EFFI_PROV_GT1_PAIS=GT
EFFI_PROV_GT1_API_KEY=

EFFI_PROV_GT2_NOMBRE=
EFFI_PROV_GT2_TIPO=proveeduria
EFFI_PROV_GT2_PAIS=GT
EFFI_PROV_GT2_API_KEY=

EFFI_PROV_HN_NOMBRE=
EFFI_PROV_HN_TIPO=proveeduria
EFFI_PROV_HN_PAIS=HN
EFFI_PROV_HN_API_KEY=

EFFI_PROV_CR_NOMBRE=
EFFI_PROV_CR_TIPO=proveeduria
EFFI_PROV_CR_PAIS=CR
EFFI_PROV_CR_API_KEY=

# ── Supabase (se llena al crear el proyecto en supabase.com) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Token que usan el cron y scripts/push-effi-keys.mjs para hablar con la función effi-sync (se genera en el Vault de Supabase)
EFFI_SYNC_TOKEN=

# ── Webhooks de Effi (se llena al registrar cada webhook; Effi muestra el secreto una sola vez) ──
EFFI_WEBHOOK_SECRET_TIENDA_CO=
